{
  "name": "mikapo",
  "version": "4.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev-web": "next dev --turbopack -p 4000",
    "dev": "concurrently \"next dev --turbopack -p 4000\" \"wait-on http://localhost:4000 && electron .\"",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" && eslint \"src/**/*.{ts,tsx}\" --fix",
    "electron-build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.mikapo.app",
    "productName": "MiKaPo",
    "files": [
      "out/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.png"
    }
  },
  "dependencies": {
    "@babylonjs/core": "^8.11.0",
    "@babylonjs/materials": "^8.11.0",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/encoding-japanese": "^2.2.1",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "encoding-japanese": "^2.2.0",
    "lucide-react": "^0.523.0",
    "next": "^15.5.6",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reze-engine": "^0.36.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "string-replace-loader": "^3.2.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  }
}
